# Keepy MP3 — Firebase 설정 키 목록 (실제 값은 넣지 않는다)
#
# 1) 이 파일을 복사해서 같은 폴더에 ".env" 라는 이름으로 저장
# 2) 아래 = 뒤에 Firebase 콘솔의 값을 붙여넣기 (따옴표 없이)
# 3) 실행: flutter run --dart-define-from-file=.env
#
# 값 찾는 곳: Firebase 콘솔 → 프로젝트 설정(톱니) → 내 앱 → Android 앱
#            → google-services.json 다운로드 → 아래 표의 항목
#
#   FIREBASE_API_KEY             ← client[0].api_key[0].current_key
#   FIREBASE_APP_ID              ← client[0].client_info.mobilesdk_app_id
#   FIREBASE_MESSAGING_SENDER_ID ← project_info.project_number
#   FIREBASE_PROJECT_ID          ← project_info.project_id
#
# .env 가 없으면 앱은 로그인 없이 이 기기에만 저장하는 게스트 모드로 실행된다.

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
