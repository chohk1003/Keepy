# Keepy 설정 키 목록 (MP3 · NFR-06 · CST-04)
#
# 1. 이 파일을 복사해 같은 폴더(app/)에 .env 를 만든다.
#      PowerShell:  Copy-Item .env.example .env
# 2. 아래 두 값을 Supabase 대시보드 > Project Settings > API(또는 Data API) 에서 복사해 채운다.
# 3. 실행할 때 붙인다:  flutter run -d chrome --dart-define-from-file=.env
#
# .env 는 .gitignore 로 제외되어 GitHub 에 올라가지 않는다. 이 예시 파일만 제출한다.
# 값을 비워 두면 동기화가 꺼진 채로(이 기기에만 저장) 실행된다.

# 프로젝트 주소. 예: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# 공개용 키: 'Publishable key'(sb_publishable_…) 또는 예전 'anon public' 키 둘 다 됨
# (Secret key·service_role 키는 절대 넣지 말 것)
SUPABASE_ANON_KEY=
