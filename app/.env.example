# Keepy 환경 변수 예시 (NFR-06, CST-04)
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요. .env 는 절대 커밋하지 않습니다.
#
#   cp .env.example .env
#
# 현재 버전(MP2)은 로컬 저장만 사용하므로 아래 값이 없어도 실행됩니다.
# BaaS 연동(FR-01, FR-11, FR-12) 단계에서 하나를 골라 채웁니다.

# --- Supabase를 쓸 경우 ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase를 쓸 경우 ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
